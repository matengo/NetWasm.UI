<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Package metadata. Only projects under src/ are packable (see src/Directory.Build.props). -->
  <PropertyGroup>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>NetWasm.UI contributors</Authors>
    <Copyright>Copyright (c) 2026 NetWasm.UI contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/matengo/NetWasm.UI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/matengo/NetWasm.UI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>netwasm;wasm;webassembly;ui;signals;reactive;spa</PackageTags>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
