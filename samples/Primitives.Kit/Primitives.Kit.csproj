<Project Sdk="Microsoft.NET.Sdk">
  <!-- A headless component library: behaviour, ARIA and data-state, no CSS. Primitives.Theme styles it. -->
  <PropertyGroup>
    <!-- netstandard2.1: one build serves browser apps (netwasm0.1), prerendering and NwUi.Testing (net10.0). -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Primitives.Kit</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NetWasm.UI\NetWasm.UI.csproj" />
  </ItemGroup>
  <!-- A package reference to NwUi imports this file from buildTransitive; a project reference does not. -->
  <Import Project="..\..\src\NetWasm.UI\build\NetWasm.UI.targets" />
</Project>
