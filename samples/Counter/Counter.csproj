<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework>netwasm0.1</TargetFramework>
    <OutputType>JsModule</OutputType>
    <NetWasmJavaScriptHosts>page</NetWasmJavaScriptHosts>
    <!-- NetWasmGC: faster allocation and collection than the default Compact collector, for about 1.6 KB more
         download (Brotli). Remove this line to keep Compact. -->
    <NetWasmGarbageCollector>NetWasm</NetWasmGarbageCollector>
    <RootNamespace>Counter</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NetWasm.UI\NetWasm.UI.csproj" />
    <ProjectReference Include="..\..\src\NetWasm.UI.Browser\NetWasm.UI.Browser.csproj" />
    <!-- Compiles *.nwui templates into components at build time. -->
    <ProjectReference Include="..\..\src\NetWasm.UI.Generator\NetWasm.UI.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      UndefineProperties="TargetFramework" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="**\*.nwui" Exclude="bin\**;obj\**" />
    <CompilerVisibleProperty Include="RootNamespace;ProjectDir" />
  </ItemGroup>
  <ItemGroup>
    <NetWasmJavaScriptModule Include="..\..\src\NetWasm.UI.Browser\dom.mjs" Module="nwui.dom" />
    <Content Include="index.html;app.mjs" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Publish-time preload tags and prerendered pages, as the NwUi.Browser package adds them for consumers.
       Other paths (e.g. /greet/world) get the bare 404.html and render once the Wasm has loaded. -->
  <PropertyGroup>
    <NetWasmUIPrerender>true</NetWasmUIPrerender>
    <NetWasmUIPrerenderShell>404.html</NetWasmUIPrerenderShell>
  </PropertyGroup>
  <ItemGroup>
    <NetWasmUIPrerenderRoute Include="/counter;/todos" />
  </ItemGroup>
  <Import Project="..\..\src\NetWasm.UI.Browser\build\NetWasm.UI.Preload.targets" />
  <Import Project="..\..\src\NetWasm.UI.Browser\build\NetWasm.UI.Prerender.targets" />
</Project>
