@using Counter.Components
@* The same room planner twice: once as a template, once in C#. Both use the same components. *@
<Page Id="components" Title="Components">
    <p>Panel and Stepper are .nwui components, ProgressBar is a C# component. The left side
       composes them in a template, the right side in plain C#.</p>
    <div class="variants">
        <RoomRazor />
        <RoomCode />
    </div>
    <section class="guarded">
        <h3>Error boundary</h3>
        <ErrorBoundary>
            <button id="fragile" @onclick="() => Hit()">Clicks: @Hits (fails on 3)</button>
            <template slot="Fallback" context="error">
                <p class="error">Oops: @error.Message <button id="retry" @onclick="() => error.Reset()">Retry</button></p>
            </template>
        </ErrorBoundary>
    </section>
</Page>

@code {
    [Reactive] private partial int Hits { get; set; }

    private void Hit()
    {
        Hits++;
        if (Hits == 3)
        {
            throw new System.InvalidOperationException("click number 3 failed");
        }
    }
}
