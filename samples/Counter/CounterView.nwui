<Page Id="counter" Title="Counter">
    <p>Count: <strong id="count">@count</strong> &middot; doubled: @doubled</p>
    <button id="inc" @onclick="() => count.Value++">+1</button>
    <button id="dec" @onclick="() => count.Value--">-1</button>
    <button id="reset" disabled="@(count.Value == 0)" @onclick="() => count.Value = 0">Reset</button>
    @if (count.Value >= 10) {
        <p class="hint">That's a lot of clicks!</p>
    }
</Page>

@code {
    private Signal<int> count = null!;
    private Computed<int> doubled = null!;

    partial void OnInit()
    {
        count = Use(AppState.Context).Count;
        doubled = new Computed<int>(() => count.Value * 2);
    }
}
