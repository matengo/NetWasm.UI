<Project Sdk="NetWasm.Sdk">
  <!-- The route optimizer: a C# Web Worker. samples/Tsp references it with NetWasmWorker="true" and publishes it
       into browser/workers/Tsp.Solver/. -->
  <PropertyGroup>
    <TargetFramework>net10.0-netwasm</TargetFramework>
    <OutputType>JsModule</OutputType>
    <NetWasmJavaScriptHosts>worker</NetWasmJavaScriptHosts>
    <!-- No type-names sidecar: the worker does not read type names, so Release skips that download. -->
    <NetWasmTypeNames>false</NetWasmTypeNames>
    <RootNamespace>Tsp.Solver</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tsp.Contracts\Tsp.Contracts.csproj" />
    <ProjectReference Include="..\..\src\NetWasm.UI.Workers\NetWasm.UI.Workers.csproj" />
    <ProjectReference Include="..\..\src\NetWasm.UI.Workers.Generator\NetWasm.UI.Workers.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      UndefineProperties="TargetFramework" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- Adds the nwui.workers.worker module, as the NwUi.Workers package does for consumers. -->
  <Import Project="..\..\src\NetWasm.UI.Workers\build\NetWasm.UI.Workers.targets" />
</Project>
