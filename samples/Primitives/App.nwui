@* Reference components built only on core primitives. None of them is part of NetWasm.UI itself. *@
@using System.Linq
@using Primitives.Kit
<main>
    <h1>Primitives</h1>

    <section id="dialog-demo">
        <h2>Dialog</h2>
        <button id="open-dialog" type="button" @onclick="() => DialogOpen.Value = true">Open dialog</button>
        <span id="dialog-state">@(DialogOpen.Value ? "open" : "closed")</span>
        <Dialog Title="Hello" @bind-Open="DialogOpen" id="demo-dialog">
            <p>A native modal dialog. Escape or the button closes it.</p>
        </Dialog>
    </section>

    <section id="popover-demo">
        <h2>Popover</h2>
        <Popover Label="Details" @bind-Open="PopoverOpen" id="popover-trigger">
            <p>Rendered at the end of body.</p>
            <button id="popover-inner" type="button">Inside</button>
        </Popover>
        <span id="popover-state">@(PopoverOpen.Value ? "open" : "closed")</span>
    </section>

    <section id="tabs-demo">
        <h2>Tabs</h2>
        <Tabs Labels="@TabLabels">
            <template slot="Panel" context="index"><p>Panel @(index + 1)</p></template>
        </Tabs>
    </section>

    <section id="select-demo">
        <h2>Select</h2>
        <Select TItem="Fruit" Items="@Fruits" @bind-Selected="Fruit" Placeholder="Pick a fruit">
            <template slot="Option" context="fruit"><span>@fruit.Emoji @fruit.Name</span></template>
        </Select>
        <p id="select-state">Selected: @(Fruit.Value?.Name ?? "none")</p>
    </section>

    <section id="table-demo">
        <h2>DataTable</h2>
        <DataTable TItem="Fruit" Items="@Fruits" @bind-Selected="Fruit">
            <template slot="Head"><tr><th>Name</th><th>Emoji</th></tr></template>
            <template slot="Row" context="fruit"><td>@fruit.Name</td><td>@fruit.Emoji</td></template>
        </DataTable>
    </section>

    <section id="capture-demo">
        <h2>Capture</h2>
        <div @onclick='() => Log("outer")' @onclick:capture>
            <button id="capture-inner" type="button" @onclick='() => Log("inner")' @onclick:stopPropagation>Click</button>
        </div>
        <p id="capture-log">@CaptureLog.Value</p>
    </section>

    <section id="focus-demo">
        <h2>FocusScope</h2>
        <button id="open-panel" type="button" @onclick="() => PanelOpen.Value = true">Open panel</button>
        @if (PanelOpen.Value)
        {
            <FocusScope Trap="@true" id="focus-panel" @onkeydown="CloseOnEscape">
                <button id="panel-first" type="button">First</button>
                <button id="panel-middle" type="button" disabled>Disabled</button>
                <button id="panel-last" type="button" @onclick="() => PanelOpen.Value = false">Close</button>
            </FocusScope>
        }
    </section>

    <section id="exit-demo">
        <h2>Exit animations</h2>
        <button id="add-toast" type="button" @onclick="AddToast">Add toast</button>
        <ul id="toasts">
            @foreach (var toast in Toasts.Value) animate-exit
            {
                <li class="toast" @key="toast">
                    Toast @toast
                    <button class="dismiss" type="button" @onclick="() => Dismiss(toast)">Dismiss</button>
                </li>
            }
        </ul>
    </section>
</main>

@code {
    public Signal<bool> DialogOpen { get; } = new(false);
    public Signal<bool> PopoverOpen { get; } = new(false);
    public IReadOnlyList<string> TabLabels { get; } = new[] { "One", "Two", "Three" };
    public Signal<IReadOnlyList<Fruit>> Fruits { get; } = new(new[]
    {
        new Fruit("Apple", "🍎"),
        new Fruit("Banana", "🍌"),
        new Fruit("Cherry", "🍒"),
    });
    public Signal<Fruit?> Fruit { get; } = new(null);
    public Signal<string> CaptureLog { get; } = new("");

    public Signal<bool> PanelOpen { get; } = new(false);

    public Signal<IReadOnlyList<int>> Toasts { get; } = new(System.Array.Empty<int>());
    private int nextToast;

    private void AddToast() => Toasts.Value = Toasts.Value.Append(++nextToast).ToArray();

    private void Dismiss(int toast) => Toasts.Value = Toasts.Value.Where(t => t != toast).ToArray();

    private void Log(string who) => CaptureLog.Value += who + " ";

    private void CloseOnEscape(DomEvent e)
    {
        if (e.Key == "Escape") PanelOpen.Value = false;
    }
}
