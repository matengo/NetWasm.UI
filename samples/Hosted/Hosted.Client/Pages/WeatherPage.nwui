<section class="container page">
    <h1>Weather</h1>
    <p class="muted">Data from <code>GET /api/weatherforecast</code> on the same ASP.NET Core server.</p>
    @if (forecasts.Error != null) {
        <p class="field-error">Could not load: @(forecasts.Error!.Message)</p>
    } else if (forecasts.Latest == null) {
        <p id="loading"><em>Loading…</em></p>
    } else {
        <div class="table-wrap">
            <table class="table bench" id="forecast">
                <thead>
                    <tr><th>Date</th><th>Temp. (C)</th><th>Temp. (F)</th><th>Summary</th></tr>
                </thead>
                <tbody>
                    @foreach (var f in forecasts.Latest ?? []) {
                        <tr>
                            <td>@f.Date.ToString("yyyy-MM-dd")</td>
                            <td class="num">@f.TemperatureC</td>
                            <td class="num">@f.TemperatureF</td>
                            <td>@(f.Summary ?? "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="cta">
        <button class="btn" disabled="@forecasts.Loading" @onclick="() => forecasts.Refetch()">Refresh</button>
    </div>
</section>

@using Hosted.Shared
@inject WeatherApi Api

@code {
    private Resource<WeatherForecast[]> forecasts = null!;

    partial void OnInit() => forecasts = Resource.Create(Api.GetForecastAsync);
}
