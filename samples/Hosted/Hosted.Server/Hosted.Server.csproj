<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The ASP.NET Core half of samples/Hosted: the API, and the host of the NetWasm.UI client on the same origin. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hosted.Server</RootNamespace>
    <!-- NwUi.AspNetCore publishes the client into the output's (and the publish output's) client folder on every
         build; Program.cs serves it with MapNetWasmUI. -->
    <NetWasmUIClientProject>..\Hosted.Client\Hosted.Client.csproj</NetWasmUIClientProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NwUi.AspNetCore" Version="0.13.0" />
    <ProjectReference Include="..\Hosted.Shared\Hosted.Shared.csproj" />
  </ItemGroup>
</Project>