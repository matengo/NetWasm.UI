@* The benchmark results from docs/benchmarks.md, as a template with @foreach. *@
<div class="container page benchmarks">
    <div class="section-head">
        <p class="eyebrow">Benchmarks</p>
        <h1>Measured, not promised.</h1>
        <p class="lead">The js-framework-benchmark "keyed" table app and DOM-free reactive workloads,
           implemented in NetWasm.UI, SolidJS, React and Blazor WebAssembly and driven by the same
           Playwright runner. Medians in ms, lower is better; the fastest in each row is highlighted.</p>
    </div>

    <div class="table-wrap">
        <table class="table bench">
            <thead>
                <tr><th>Case</th><th>NetWasm.UI Oz</th><th>NetWasm.UI O3</th><th>SolidJS</th><th>React</th><th>Blazor</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Rows) {
                    <tr @key="row.Name">
                        <td>@row.Name</td>
                        <td class="@row.Css(0)">@row.Cell(0)</td>
                        <td class="@row.Css(1)">@row.Cell(1)</td>
                        <td class="@row.Css(2)">@row.Cell(2)</td>
                        <td class="@row.Css(3)">@row.Cell(3)</td>
                        <td class="@row.Css(4)">@row.Cell(4)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="fine-print">Windows arm64 laptop, Chromium 153, script + layout, NetWasm.Sdk 0.14.2
       with NetWasmGC, NetWasm.UI after 0.13.0; mean of two runs of 20 on an idle machine in the "Best performance" power mode.
       Each measured click follows the same last-resort GC that js-framework-benchmark forces. Layout times still move 10–30 % between runs.
       Blazor is the interpreter build. "–" means the workload does not apply (no signals).
       Download sums every response of a first visit, compressed with Brotli quality 11.</p>

    <div class="callouts">
        <div class="callout">
            <h3>Faster than React</h3>
            <p>Faster than React on every DOM case.</p>
        </div>
        <div class="callout">
            <h3>On par with Solid</h3>
            <p>DOM updates take 0.95–1.25× SolidJS's time, and reactive and compute workloads are faster than Solid, most of them about 2× (up to 9× for compute).</p>
        </div>
        <div class="callout">
            <h3>Far ahead of Blazor</h3>
            <p>3–30× faster than Blazor WebAssembly, with a ~18× smaller download and ~9× faster startup.</p>
        </div>
        <div class="callout">
            <h3>No loading waterfall</h3>
            <p>Since 0.7, publish preloads the runtime and the Wasm. On ordinary broadband the demo app renders in 315 ms instead of 703 ms, more than twice as fast.</p>
        </div>
    </div>

    <p><a class="btn" href="https://github.com/matengo/NetWasm.UI/blob/main/docs/benchmarks.md" target="_blank" rel="noopener">Method, raw numbers and what is still open →</a></p>
</div>

@code {
    public sealed class Row(string name, params double[] values)
    {
        public string Name { get; } = name;

        public string Cell(int i) => values[i] < 0 ? "–" : Format(values[i]);

        public string Css(int i) => values[i] >= 0 && values[i] == Best() ? "num best" : "num";

        private double Best()
        {
            var best = double.MaxValue;
            foreach (var v in values)
            {
                if (v >= 0 && v < best)
                {
                    best = v;
                }
            }

            return best;
        }

        private static string Format(double value)
        {
            var tenths = (long)(value * 10 + 0.5);
            return (tenths / 10).ToString() + "." + (tenths % 10).ToString();
        }
    }

    private const double NA = -1;

    private static readonly Row[] Rows =
    [
        new("create 1,000 rows", 45.0, 43.0, 44.9, 63.7, 211.1),
        new("replace 1,000 rows", 50.5, 48.3, 51.9, 76.7, 245.7),
        new("partial update (every 10th)", 24.6, 23.5, 24.7, 32.8, 83.2),
        new("select row", 1.9, 1.6, 1.6, 7.8, 62.3),
        new("swap rows", 5.7, 5.0, 5.9, 49.1, 58.6),
        new("remove row", 5.5, 4.7, 5.6, 10.7, 64.6),
        new("create 10,000 rows", 437.9, 423.2, 410.9, 605.4, 1336.9),
        new("append 1,000 rows", 63.3, 59.9, 50.6, 72.3, 209.6),
        new("clear 1,000 rows", 8.5, 8.6, 8.9, 16.0, 48.2),
        new("reactive: deep (100-chain)", 9.0, 7.5, 17.7, NA, NA),
        new("reactive: broad (1,000 fan-out)", 27.6, 18.2, 32.8, NA, NA),
        new("reactive: diamond", 2.2, 1.5, 4.2, NA, NA),
        new("reactive: create/dispose 10k", 7.6, 4.8, 13.9, NA, NA),
        new("sort 100k strings (no UI)", 51.3, 47.9, 108.2, NA, 263.9),
        new("sieve 2M (no UI)", 5.9, 7.2, 55.6, NA, 32.8),
        new("startup (ms)", 103.7, 108.9, 20.9, 48.6, 917.8),
        new("download, Brotli (KB)", 118.5, 137.3, 6.2, 58.4, 2087.3),
    ];

    partial void OnInit() => AppRoot.SetTitle("Benchmarks");
}
