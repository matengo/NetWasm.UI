@* The benchmark results from docs/benchmarks.md, as a template with @foreach. *@
<div class="container page benchmarks">
    <div class="section-head">
        <p class="eyebrow">Benchmarks</p>
        <h1>Measured, not promised.</h1>
        <p class="lead">The js-framework-benchmark "keyed" table app and DOM-free reactive workloads,
           implemented in NetWasm.UI, SolidJS, React and Blazor WebAssembly and driven by the same
           Playwright runner. Medians in ms, lower is better; the fastest in each row is highlighted.</p>
    </div>

    <div class="table-wrap">
        <table class="table bench">
            <thead>
                <tr><th>Case</th><th>NetWasm.UI Oz</th><th>NetWasm.UI O3</th><th>SolidJS</th><th>React</th><th>Blazor</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Rows) {
                    <tr @key="row.Name">
                        <td>@row.Name</td>
                        <td class="@row.Css(0)">@row.Cell(0)</td>
                        <td class="@row.Css(1)">@row.Cell(1)</td>
                        <td class="@row.Css(2)">@row.Cell(2)</td>
                        <td class="@row.Css(3)">@row.Cell(3)</td>
                        <td class="@row.Css(4)">@row.Cell(4)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="fine-print">Windows arm64 laptop, Chromium 153, 10 runs, script + layout, NetWasm.Sdk 0.13.0
       with NetWasmGC. Blazor is the interpreter build. "–" means the workload does not apply (no signals).
       Download sums every response of a first visit, compressed with Brotli quality 11.</p>

    <div class="callouts">
        <div class="callout">
            <h3>Level with React</h3>
            <p>Level with or faster than React on every DOM case.</p>
        </div>
        <div class="callout">
            <h3>Close to Solid</h3>
            <p>Between 0.8× and 1.6× SolidJS's time, and faster on every reactive and compute workload.</p>
        </div>
        <div class="callout">
            <h3>Far ahead of Blazor</h3>
            <p>3–20× faster than Blazor WebAssembly, with a ~18× smaller download and ~9× faster startup.</p>
        </div>
        <div class="callout">
            <h3>No loading waterfall</h3>
            <p>Since 0.7, publish preloads the runtime and the Wasm. On ordinary broadband the demo app renders in 315 ms instead of 703 ms, more than twice as fast.</p>
        </div>
    </div>

    <p><a class="btn" href="https://github.com/matengo/NetWasm.UI/blob/main/docs/benchmarks.md" target="_blank" rel="noopener">Method, raw numbers and what is still open →</a></p>
</div>

@code {
    public sealed class Row(string name, params double[] values)
    {
        public string Name { get; } = name;

        public string Cell(int i) => values[i] < 0 ? "–" : Format(values[i]);

        public string Css(int i) => values[i] >= 0 && values[i] == Best() ? "num best" : "num";

        private double Best()
        {
            var best = double.MaxValue;
            foreach (var v in values)
            {
                if (v >= 0 && v < best)
                {
                    best = v;
                }
            }

            return best;
        }

        private static string Format(double value)
        {
            var tenths = (long)(value * 10 + 0.5);
            return (tenths / 10).ToString() + "." + (tenths % 10).ToString();
        }
    }

    private const double NA = -1;

    private static readonly Row[] Rows =
    [
        new("create 1,000 rows", 54.7, 59.6, 71.0, 67.7, 236.3),
        new("replace 1,000 rows", 62.3, 65.8, 62.7, 81.8, 263.3),
        new("partial update (every 10th)", 26.5, 22.1, 22.5, 27.1, 88.9),
        new("select row", 4.8, 5.4, 3.2, 14.2, 95.1),
        new("swap rows", 7.5, 8.3, 9.0, 61.2, 69.0),
        new("remove row", 5.0, 5.3, 6.0, 10.3, 80.6),
        new("create 10,000 rows", 588.9, 557.8, 489.2, 1041.7, 2405.2),
        new("append 1,000 rows", 78.5, 88.5, 62.5, 113.8, 302.0),
        new("clear 1,000 rows", 15.8, 20.5, 10.1, 20.6, 81.8),
        new("reactive: deep (100-chain)", 9.3, 9.2, 21.0, NA, NA),
        new("reactive: broad (1,000 fan-out)", 28.1, 21.5, 35.3, NA, NA),
        new("reactive: diamond", 2.6, 1.9, 4.3, NA, NA),
        new("reactive: create/dispose 10k", 7.8, 6.1, 18.1, NA, NA),
        new("sort 100k strings (no UI)", 60.1, 57.7, 132.2, NA, 643.6),
        new("sieve 2M (no UI)", 6.8, 7.8, 130.1, NA, 67.5),
        new("startup (ms)", 127.9, 133.7, 25.4, 57.0, 1204.6),
        new("download, Brotli (KB)", 114.0, 128.0, 6.2, 58.4, 2087.3),
    ];

    partial void OnInit() => AppRoot.SetTitle("Benchmarks");
}
