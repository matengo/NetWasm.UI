@* The benchmark results from docs/benchmarks.md, as a template with @foreach. *@
<div class="container page benchmarks">
    <div class="section-head">
        <p class="eyebrow">Benchmarks</p>
        <h1>Measured, not promised.</h1>
        <p class="lead">The js-framework-benchmark "keyed" table app and DOM-free reactive workloads,
           implemented in NetWasm.UI, SolidJS, React and Blazor WebAssembly and driven by the same
           Playwright runner. Medians in ms, lower is better; the fastest in each row is highlighted.</p>
    </div>

    <div class="table-wrap">
        <table class="table bench">
            <thead>
                <tr><th>Case</th><th>NetWasm.UI Oz</th><th>NetWasm.UI O3</th><th>SolidJS</th><th>React</th><th>Blazor</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Rows) {
                    <tr @key="row.Name">
                        <td>@row.Name</td>
                        <td class="@row.Css(0)">@row.Cell(0)</td>
                        <td class="@row.Css(1)">@row.Cell(1)</td>
                        <td class="@row.Css(2)">@row.Cell(2)</td>
                        <td class="@row.Css(3)">@row.Cell(3)</td>
                        <td class="@row.Css(4)">@row.Cell(4)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="fine-print">Windows arm64 laptop, Chromium 153, 10 runs, script + layout, NetWasm.Sdk 0.10.7.
       Blazor is the interpreter build. "–" means the workload does not apply (no signals).
       Download sums every response of a first visit, compressed with Brotli quality 11.</p>

    <div class="callouts">
        <div class="callout">
            <h3>Level with React</h3>
            <p>Level with or faster than React on every DOM case.</p>
        </div>
        <div class="callout">
            <h3>Close to Solid</h3>
            <p>Between 0.9× and 1.6× SolidJS's time, and faster on the deep, broad and diamond reactive workloads.</p>
        </div>
        <div class="callout">
            <h3>Far ahead of Blazor</h3>
            <p>3–21× faster than Blazor WebAssembly, with a ~12× smaller download and ~9× faster startup.</p>
        </div>
    </div>

    <p><a class="btn" href="https://github.com/matengo/NetWasm.UI/blob/main/docs/benchmarks.md" target="_blank" rel="noopener">Method, raw numbers and what is still open →</a></p>
</div>

@code {
    public sealed class Row(string name, params double[] values)
    {
        public string Name { get; } = name;

        public string Cell(int i) => values[i] < 0 ? "–" : Format(values[i]);

        public string Css(int i) => values[i] >= 0 && values[i] == Best() ? "num best" : "num";

        private double Best()
        {
            var best = double.MaxValue;
            foreach (var v in values)
            {
                if (v >= 0 && v < best)
                {
                    best = v;
                }
            }

            return best;
        }

        private static string Format(double value)
        {
            var tenths = (long)(value * 10 + 0.5);
            return (tenths / 10).ToString() + "." + (tenths % 10).ToString();
        }
    }

    private const double NA = -1;

    private static readonly Row[] Rows =
    [
        new("create 1,000 rows", 57.0, 60.3, 60.7, 77.1, 251.9),
        new("replace 1,000 rows", 64.7, 67.7, 58.1, 86.1, 276.4),
        new("partial update (every 10th)", 23.9, 40.5, 25.1, 34.9, 93.9),
        new("select row", 4.5, 4.0, 3.3, 13.8, 94.1),
        new("swap rows", 6.6, 7.8, 7.4, 59.9, 61.4),
        new("remove row", 6.3, 5.6, 6.3, 11.0, 72.5),
        new("create 10,000 rows", 624.9, 602.1, 512.4, 996.4, 2652.0),
        new("append 1,000 rows", 98.6, 99.3, 60.2, 95.7, 327.8),
        new("clear 1,000 rows", 13.6, 14.3, 10.3, 16.7, 65.7),
        new("reactive: deep (100-chain)", 12.1, 9.5, 23.1, NA, NA),
        new("reactive: broad (1,000 fan-out)", 32.1, 27.3, 38.3, NA, NA),
        new("reactive: diamond", 2.6, 2.3, 3.5, NA, NA),
        new("reactive: create/dispose 10k", 17.5, 17.4, 13.5, NA, NA),
        new("sort 100k strings (no UI)", 99.0, 99.5, 124.6, NA, 645.5),
        new("sieve 2M (no UI)", 9.4, 11.6, 125.3, NA, 47.2),
        new("startup (ms)", 131.2, 133.6, 25.9, 64.2, 1209.9),
        new("download, Brotli (KB)", 117.6, 130.3, 6.2, 58.4, 1442.2),
    ];

    partial void OnInit() => AppRoot.SetTitle("Benchmarks");
}
