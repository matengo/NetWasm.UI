@* The live counter in the hero. Every click updates exactly two text nodes. *@
<div class="hero-demo">
    <div class="hero-demo-head">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="hero-demo-title">HeroCounter.nwui · running now</span>
    </div>
    <div class="hero-demo-body">
        <p class="hero-count"><strong>@count</strong><small>clicks</small></p>
        <p class="hero-sub">doubled: <strong>@doubled</strong></p>
        <div class="hero-buttons">
            <button class="btn btn-primary" @onclick="() => count.Value++">+1</button>
            <button class="btn" disabled="@(count.Value == 0)" @onclick="() => count.Value = 0">Reset</button>
        </div>
        @if (count.Value >= 10) {
            <p class="hero-hint">That's a lot of clicks. Each one crossed into JS once.</p>
        }
    </div>
</div>

@code {
    private readonly Signal<int> count = new(0);
    private Computed<int> doubled = null!;

    partial void OnInit() => doubled = new Computed<int>(() => count.Value * 2);
}
