@* A frame with a title, an optional Actions slot and child content. *@
<section class="card">
    <div class="card-head">
        <h3>@Title</h3>
        @if (Actions is not null) {
            <div class="card-actions">@render(Actions)</div>
        }
    </div>
    @render(ChildContent)
</section>

@prop string Title = "";

@code {
    public Slot? Actions { get; set; }
    public Slot? ChildContent { get; set; }
}
