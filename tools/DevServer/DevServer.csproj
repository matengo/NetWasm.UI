<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NetWasm.UI.DevServer</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Keep paths passed via `dotnet run` relative to where the user ran it. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="reload-client.js" LogicalName="reload-client.js" />
  </ItemGroup>
</Project>
