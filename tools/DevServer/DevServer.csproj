<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NetWasm.UI.DevServer</RootNamespace>
    <!-- Keep paths passed via `dotnet run` relative to where the user ran it. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
    <!-- Shipped as a .NET tool: `dotnet nwui-dev` in an app folder. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nwui-dev</ToolCommandName>
    <PackageId>NetWasm.UI.DevServer</PackageId>
    <Description>Development server for NetWasm.UI apps: publishes the app, serves it with Brotli and SPA fallback, and rebuilds + reloads the browser on save.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="reload-client.js" LogicalName="reload-client.js" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
