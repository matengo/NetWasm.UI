{
  "name": "nwui",
  "displayName": "NetWasm.UI templates (.nwui)",
  "description": "Syntax highlighting for NetWasm.UI .nwui templates: HTML with embedded C#.",
  "version": "0.1.0",
  "publisher": "netwasm-ui",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "nwui",
        "aliases": ["NetWasm.UI Template", "nwui"],
        "extensions": [".nwui"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nwui",
        "scopeName": "text.html.nwui",
        "path": "./syntaxes/nwui.tmLanguage.json",
        "embeddedLanguages": {
          "source.cs": "csharp",
          "meta.embedded.block.csharp": "csharp",
          "meta.embedded.expression.csharp": "csharp",
          "source.css": "css",
          "source.js": "javascript"
        }
      }
    ]
  },
  "scripts": {
    "test": "node --test test/grammar.test.mjs",
    "package": "vsce package --allow-missing-repository --skip-license --out nwui.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "tm-grammars": "^1.24.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
