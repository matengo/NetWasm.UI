{
  "name": "nwui",
  "displayName": "NetWasm.UI templates (.nwui)",
  "description": "Syntax highlighting for NetWasm.UI .nwui templates: HTML with embedded C#.",
  "version": "0.1.0",
  "publisher": "netwasm-ui",
  "license": "MIT",
  "private": true,
  "icon": "images/icon.png",
  "repository": { "type": "git", "url": "https://github.com/matengo/NetWasm.UI.git", "directory": "tools/vscode-nwui" },
  "homepage": "https://github.com/matengo/NetWasm.UI/blob/main/docs/templates.md",
  "bugs": "https://github.com/matengo/NetWasm.UI/issues",
  "keywords": ["netwasm", "webassembly", "wasm", "csharp", "nwui"],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "galleryBanner": { "color": "#512BD4", "theme": "dark" },
  "galleryBanner": { "color": "#512BD4", "theme": "dark" },
  "contributes": {
    "languages": [
      {
        "id": "nwui",
        "aliases": ["NetWasm.UI Template", "nwui"],
        "extensions": [".nwui"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nwui",
        "scopeName": "text.html.nwui",
        "path": "./syntaxes/nwui.tmLanguage.json",
        "embeddedLanguages": {
          "source.cs": "csharp",
          "meta.embedded.block.csharp": "csharp",
          "meta.embedded.expression.csharp": "csharp",
          "source.css": "css",
          "source.js": "javascript"
        }
      }
    ]
  },
  "scripts": {
    "test": "node --test test/grammar.test.mjs",
    "package": "vsce package --out nwui.vsix",
    "publish": "vsce publish",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "tm-grammars": "^1.24.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
