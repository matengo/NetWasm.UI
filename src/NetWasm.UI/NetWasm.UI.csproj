<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netwasm0.1;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>NetWasm.UI</RootNamespace>
    <Description>Reflection-free, signal-driven UI framework for NetWasm: fine-grained reactivity, components, routing, forms and async resources. Includes the .nwui template source generator.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NetWasm.UI.Tests" />
  </ItemGroup>

  <!-- The .nwui source generator ships in this package (analyzers/dotnet/cs) together with
       buildTransitive props that feed *.nwui files to it. -->
  <ItemGroup>
    <ProjectReference Include="..\NetWasm.UI.Generator\NetWasm.UI.Generator.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all"
                      SetTargetFramework="TargetFramework=netstandard2.0" SkipGetTargetFrameworkProperties="true" />
    <None Include="..\NetWasm.UI.Generator\bin\$(Configuration)\netstandard2.0\NetWasm.UI.Generator.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build\NetWasm.UI.props" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>
</Project>
