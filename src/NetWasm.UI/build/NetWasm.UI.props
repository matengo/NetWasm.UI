<Project>
  <!-- Feeds *.nwui templates to the NetWasm.UI source generator. Set NetWasmUIEnableTemplates=false to opt out. -->
  <ItemGroup Condition="'$(NetWasmUIEnableTemplates)' != 'false'">
    <AdditionalFiles Include="**\*.nwui" Exclude="$(DefaultItemExcludes);bin\**;obj\**" />
    <CompilerVisibleProperty Include="RootNamespace;ProjectDir" />
  </ItemGroup>
  <!-- Services.AddLazy<TService, TImplementation>() is rewritten by generated interceptors in this namespace. -->
  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);NetWasm.UI.Generated</InterceptorsNamespaces>
  </PropertyGroup>
</Project>
