<Project>
  <!-- Library assets. A component library declares the files its components need at runtime:

         <NwUiAsset Include="styles\button.css" />                       stylesheet, linked from the page
         <NwUiAsset Include="js\focus.mjs" Module="mylib.focus" />      JavaScript module for [JSImport]
         <NwUiAsset Include="fonts\icons.woff2" />                       any other file, served only

       A browser app that references the library (as a project or a package) serves every asset at
       _content/<PackageId>/<path below the library project>, bundles the modules, and its publish links the
       stylesheets from index.html (NwUi.Browser, NetWasmUIInjectAssets=false to opt out). The library's pack
       puts the files under nwui-assets/ and generates buildTransitive/<PackageId>.targets declaring them. -->

  <PropertyGroup>
    <_NwUiAssetsTargetsImported>true</_NwUiAssetsTargetsImported>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_NwUiPackAssets</TargetsForTfmSpecificContentInPackage>
    <!-- The assets are packed once, by one target framework: the NetWasm one (net10.0-netwasm) when the library
         targets it, else the first (a netstandard2.1 library, or one that targets netstandard2.1 and net10.0). -->
    <_NwUiAssetPackTfm Condition="'$(TargetFrameworks)' == ''">$(TargetFramework)</_NwUiAssetPackTfm>
    <_NwUiAssetPackTfm Condition="'$(_NwUiAssetPackTfm)' == ''">$([System.Text.RegularExpressions.Regex]::Match('$(TargetFrameworks)', '(?&lt;=(?:^|;)\s*)[^;\s]+-netwasm(?=\s*(?:;|$))').Value)</_NwUiAssetPackTfm>
    <_NwUiAssetPackTfm Condition="'$(_NwUiAssetPackTfm)' == ''">$([System.Text.RegularExpressions.Regex]::Match('$(TargetFrameworks)', '[^;\s]+').Value)</_NwUiAssetPackTfm>
  </PropertyGroup>

  <!-- The project's own assets with their package, kind and served path; the referencing app calls it. -->
  <Target Name="GetNwUiAssets" DependsOnTargets="_NwUiComputeOwnAssets" Returns="@(_NwUiOwnAsset)" />
  <Target Name="_NwUiComputeOwnAssets" Condition="'@(NwUiAsset)' != ''">
    <PropertyGroup>
      <_NwUiAssetPackage Condition="'$(PackageId)' != ''">$(PackageId)</_NwUiAssetPackage>
      <_NwUiAssetPackage Condition="'$(_NwUiAssetPackage)' == ''">$(AssemblyName)</_NwUiAssetPackage>
    </PropertyGroup>
    <ItemGroup>
      <_NwUiOwnAsset Remove="@(_NwUiOwnAsset)" />
      <_NwUiOwnAsset Include="@(NwUiAsset->'%(FullPath)')">
        <Package>$(_NwUiAssetPackage)</Package>
        <AssetPath>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)', '%(FullPath)').Replace('\', '/'))</AssetPath>
      </_NwUiOwnAsset>
    </ItemGroup>
  </Target>

  <Target Name="_NwUiPackAssets" DependsOnTargets="GetNwUiAssets"
          Condition="'$(TargetFramework)' == '$(_NwUiAssetPackTfm)' and '@(NwUiAsset)' != ''">
    <PropertyGroup>
      <_NwUiAssetTargetsFile>$(IntermediateOutputPath)nwui\$(_NwUiAssetPackage).targets</_NwUiAssetTargetsFile>
    </PropertyGroup>
    <ItemGroup>
      <_NwUiAssetLine Include="@(_NwUiOwnAsset->'    &lt;NwUiPackageAsset Include=&quot;%24(MSBuildThisFileDirectory)..\nwui-assets\%(AssetPath)&quot; Package=&quot;$(_NwUiAssetPackage)&quot; AssetPath=&quot;%(AssetPath)&quot; Module=&quot;%(Module)&quot; /&gt;')" />
    </ItemGroup>
    <WriteLinesToFile File="$(_NwUiAssetTargetsFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;Project&gt;;  &lt;!-- Generated by NwUi: the assets of $(_NwUiAssetPackage). --&gt;;  &lt;ItemGroup&gt;;@(_NwUiAssetLine);  &lt;/ItemGroup&gt;;&lt;/Project&gt;" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_NwUiOwnAsset)" PackagePath="nwui-assets\%(AssetPath)" BuildAction="None" />
      <TfmSpecificPackageFile Include="$(_NwUiAssetTargetsFile)" PackagePath="buildTransitive\$(_NwUiAssetPackage).targets" BuildAction="None" />
      <TfmSpecificPackageFile Include="$(_NwUiAssetTargetsFile)" PackagePath="build\$(_NwUiAssetPackage).targets" BuildAction="None" />
    </ItemGroup>
  </Target>

  <!-- A browser app gathers the assets of its packages, its project references (transitively) and its own, in that
       order, so that a later stylesheet (the app's) can override an earlier one (a library's). -->
  <Target Name="NwUiCollectAssets"
          BeforeTargets="NetWasmWriteCompilationIdentity;CoreCompile"
          DependsOnTargets="ResolveProjectReferences;GetNwUiAssets"
          Condition="'$(TargetPlatformIdentifier)' == 'netwasm' and '$(DesignTimeBuild)' != 'true' and ('$(_NetWasmWorkerKind)' == 'jsexport' or '$(OutputType)' == 'Exe')"
          Returns="@(NwUiResolvedAsset)">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)" Targets="GetNwUiAssets" BuildInParallel="$(BuildInParallel)"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)"
             SkipNonexistentTargets="true" Condition="'@(_MSBuildProjectReferenceExistent)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_NwUiReferencedAsset" />
    </MSBuild>
    <ItemGroup>
      <NwUiResolvedAsset Remove="@(NwUiResolvedAsset)" />
      <NwUiResolvedAsset Include="@(NwUiPackageAsset->'%(FullPath)');@(_NwUiReferencedAsset);@(_NwUiOwnAsset)" />
      <_NwUiReferencedAsset Remove="@(_NwUiReferencedAsset)" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(NwUiResolvedAsset)">
      <Output TaskParameter="Filtered" ItemName="_NwUiDistinctAsset" />
    </RemoveDuplicates>
    <ItemGroup>
      <NwUiResolvedAsset Remove="@(NwUiResolvedAsset)" />
      <NwUiResolvedAsset Include="@(_NwUiDistinctAsset)">
        <SitePath>_content/%(_NwUiDistinctAsset.Package)/%(_NwUiDistinctAsset.AssetPath)</SitePath>
      </NwUiResolvedAsset>
      <_NwUiDistinctAsset Remove="@(_NwUiDistinctAsset)" />
      <NetWasmJavaScriptModule Include="@(NwUiResolvedAsset)" Condition="'%(NwUiResolvedAsset.Module)' != ''" Module="%(NwUiResolvedAsset.Module)" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <NetWasmCollectSiteFilesDependsOn>$(NetWasmCollectSiteFilesDependsOn);_NwUiAssetSiteFiles</NetWasmCollectSiteFilesDependsOn>
  </PropertyGroup>
  <Target Name="_NwUiAssetSiteFiles" DependsOnTargets="NwUiCollectAssets"
          Condition="'$(TargetPlatformIdentifier)' == 'netwasm' and '$(DesignTimeBuild)' != 'true' and ('$(_NetWasmWorkerKind)' == 'jsexport' or '$(OutputType)' == 'Exe')">
    <ItemGroup>
      <NetWasmSiteFile Include="@(NwUiResolvedAsset)" Condition="'%(NwUiResolvedAsset.Module)' == ''" SitePath="%(NwUiResolvedAsset.SitePath)" />
    </ItemGroup>
  </Target>
</Project>
