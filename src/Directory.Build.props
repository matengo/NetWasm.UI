<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are tracked by the public API baseline, not by warnings.
         RS0026/RS0027 (optional-parameter overload rules) are relaxed until 1.0. -->
    <NoWarn>$(NoWarn);CS1591;RS0026;RS0027</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- No .snupkg: NetWasm.Sdk 0.10.x's pack task omits the SymbolsPackage package type, so nuget.org rejects it (HTTP 400). -->
    <IncludeSymbols>false</IncludeSymbols>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Public API baseline: every public API change shows up in PublicAPI.Unshipped.txt (RS0016/RS0017). -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>



