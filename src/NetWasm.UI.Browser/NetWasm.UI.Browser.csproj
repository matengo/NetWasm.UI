<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework>netwasm0.1</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>NetWasm.UI.Browser</RootNamespace>
    <PackageId>NwUi.Browser</PackageId>
    <Description>Browser host for NetWasm.UI: the nwui.dom JavaScript module (DOM batching, event delegation, History API) and BrowserApp.Start.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetWasm.UI\NetWasm.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="dom.mjs" Pack="true" PackagePath="build;buildTransitive" />
    <None Include="build\NetWasm.UI.Browser.targets" Pack="true" PackagePath="build\NwUi.Browser.targets;buildTransitive\NwUi.Browser.targets" />
    <None Include="build\NetWasm.UI.Preload.targets" Pack="true" PackagePath="build;buildTransitive" />
    <None Include="build\NetWasm.UI.Prerender.targets;build\prerender.mjs" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>
</Project>
