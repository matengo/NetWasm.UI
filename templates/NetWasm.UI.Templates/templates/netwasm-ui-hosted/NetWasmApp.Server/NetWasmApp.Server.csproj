<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The ASP.NET Core half of the app: the API, and the host of the NetWasm.UI client on the same origin. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NetWasmApp.Server</RootNamespace>
    <!-- NwUi.AspNetCore publishes the client into the output's (and the publish output's) client folder on every
         build; Program.cs serves it with MapNetWasmUI. -->
    <NetWasmUIClientProject>..\NetWasmApp.Client\NetWasmApp.Client.csproj</NetWasmUIClientProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NwUi.AspNetCore" Version="0.13.0" />
    <ProjectReference Include="..\NetWasmApp.Shared\NetWasmApp.Shared.csproj" />
  </ItemGroup>
</Project>
