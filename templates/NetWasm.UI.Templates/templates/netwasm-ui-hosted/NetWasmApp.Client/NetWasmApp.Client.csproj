<Project Sdk="NetWasm.Sdk">
  <!-- The browser half of the app: a NetWasm.UI app. NetWasmApp.Server publishes it and serves it. -->
  <PropertyGroup>
    <TargetFramework>netwasm0.1</TargetFramework>
    <OutputType>JsModule</OutputType>
    <NetWasmJavaScriptHosts>page</NetWasmJavaScriptHosts>
    <!-- NetWasmGC: faster allocation and collection than the default Compact collector, for about 1.6 KB more
         download (Brotli). Remove this line to keep Compact. -->
    <NetWasmGarbageCollector>NetWasm</NetWasmGarbageCollector>
    <RootNamespace>NetWasmApp.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- NetWasmApp.Shared targets .NET Standard, which netwasm0.1 consumes; NU1702 only notes the framework fallback. -->
    <NoWarn>$(NoWarn);NU1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- NetWasm.UI, its browser host and the .nwui source generator. -->
    <PackageReference Include="NwUi.Browser" Version="0.14.0" />
    <ProjectReference Include="..\NetWasmApp.Shared\NetWasmApp.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- index.html, app.mjs and the styles, at the root of the published app. -->
    <Content Include="wwwroot\**" CopyToPublishDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Publish-time prerendering: each route is rendered into its own page (index.html, counter.html, weather.html),
       which the server returns for that path, so content shows before the Wasm has loaded. Other paths get the bare
       shell.html and render once the Wasm has loaded. -->
  <PropertyGroup>
    <NetWasmUIPrerender>true</NetWasmUIPrerender>
    <NetWasmUIPrerenderShell>shell.html</NetWasmUIPrerenderShell>
    <NetWasmUIPrerenderExport>prerender</NetWasmUIPrerenderExport>
  </PropertyGroup>
  <ItemGroup>
    <NetWasmUIPrerenderRoute Include="/counter;/weather" />
  </ItemGroup>
</Project>
