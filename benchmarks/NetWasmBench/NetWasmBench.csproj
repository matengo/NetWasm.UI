<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework>netwasm0.1</TargetFramework>
    <OutputType>JsModule</OutputType>
    <NetWasmJavaScriptHosts>page</NetWasmJavaScriptHosts>
    <!-- NetWasmGC: faster allocation and collection than the default Compact collector, for about 1.6 KB more
         download (Brotli). Remove this line to keep Compact. -->
    <NetWasmGarbageCollector>NetWasm</NetWasmGarbageCollector>
    <RootNamespace>NetWasmBench</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NetWasm.UI\NetWasm.UI.csproj" />
    <ProjectReference Include="..\..\src\NetWasm.UI.Browser\NetWasm.UI.Browser.csproj" />
  </ItemGroup>
  <ItemGroup>
    <NetWasmJavaScriptModule Include="..\..\src\NetWasm.UI.Browser\dom.mjs" Module="nwui.dom" />
    <Content Include="index.html;app.mjs" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
