@using Microsoft.JSInterop
@inject IJSRuntime JS

@* js-framework-benchmark keyed Blazor: rows are components that skip re-rendering when unchanged. *@
<div class="container">
  <div class="jumbotron">
    <h1>Blazor keyed</h1>
    <div class="buttons">
      <button id="run" type="button" @onclick="Run">Create 1,000 rows</button>
      <button id="runlots" type="button" @onclick="RunLots">Create 10,000 rows</button>
      <button id="add" type="button" @onclick="Add">Append 1,000 rows</button>
      <button id="update" type="button" @onclick="Update">Update every 10th row</button>
      <button id="clear" type="button" @onclick="Clear">Clear</button>
      <button id="swaprows" type="button" @onclick="SwapRows">Swap Rows</button>
    </div>
  </div>
  <table class="table table-hover table-striped test-data">
    <tbody id="tbody">
      @foreach (var row in data)
      {
        <BenchRow @key="row" Row="row" Selected="row.Id == selected" OnSelect="Select" OnRemove="Remove" />
      }
    </tbody>
  </table>
  <span class="preloadicon glyphicon glyphicon-remove" aria-hidden="true"></span>
</div>

@code {
    private List<RowData> data = new();
    private int selected;

    private void Run()
    {
        data = Data.Build(1000);
        selected = 0;
    }

    private void RunLots()
    {
        data = Data.Build(10000);
        selected = 0;
    }

    private void Add() => data.AddRange(Data.Build(1000));

    private void Update()
    {
        for (var i = 0; i < data.Count; i += 10)
        {
            data[i].Label += " !!!";
        }
    }

    private void Clear()
    {
        data = new();
        selected = 0;
    }

    private void SwapRows()
    {
        if (data.Count > 998)
        {
            (data[1], data[998]) = (data[998], data[1]);
        }
    }

    private void Select(int id) => selected = id;

    private void Remove(int id) => data.RemoveAt(data.FindIndex(r => r.Id == id));

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            ((IJSInProcessRuntime)JS).InvokeVoid("benchReady");
        }
    }
}
